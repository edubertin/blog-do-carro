{
  "name": "@blog-do-carro/site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:test": "cross-env NODE_OPTIONS=--import=./tests/cloudflare-workers-loader.mjs WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run build && npm run test:unit && npm run test:db && npm run test:rendered",
    "test:unit": "node --test tests/tiptap-article-adapter.test.mjs tests/audience-domain.test.mjs",
    "test:db": "node --test tests/database-foundation.test.mjs",
    "test:rendered": "node --import ./tests/cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs tests/editorial-integration.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "qa": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:db && npm run test:rendered"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "motion": "^13.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
